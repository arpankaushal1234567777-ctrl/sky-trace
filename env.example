# ============================================================
# SkyTrace — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in your real values in .env.local
#   3. Never commit .env.local to Git
# ============================================================


# ------------------------------------------------------------
# AVIATIONSTACK — Flight Data
# Get your key at: https://aviationstack.com/
# Free plan: 500 requests/month (data delayed 15–60 min)
# Paid plans: real-time data from $9.99/month
# ------------------------------------------------------------
AVIATIONSTACK_KEY=your_aviationstack_api_key_here


# ------------------------------------------------------------
# OPENWEATHERMAP — Weather Data
# Get your key at: https://openweathermap.org/api
# Free plan: 1,000 calls/day
# Note: new keys take up to 2 hours to activate
# ------------------------------------------------------------
OPENWEATHER_KEY=your_openweathermap_api_key_here


# ------------------------------------------------------------
# TWILIO — SMS & Phone Call Alerts
# Get your credentials at: https://console.twilio.com/
# Account SID starts with "AC"
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio phone number in E.164 format
# E.164 format = + followed by country code + number, no spaces
# Examples:
#   US number:     +12025551234
#   India number:  +919876543210
#   UK number:     +447911123456
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
